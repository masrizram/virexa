# Virexa environment — copy to .env and fill values. NEVER commit real values.
# Format of every secret is documented in docs/operations.md.

# --- Neon PostgreSQL ---
# Pooled (PgBouncer transaction pooling) for runtime workloads:
APP_DATABASE_URL=postgresql://content_runtime:PASSWORD@HOST-pooler.REGION.aws.neon.tech/content_os?sslmode=require
# Direct connection for Alembic migrations / session-level operations:
APP_DATABASE_DIRECT_URL=postgresql://content_migrator:PASSWORD@HOST.REGION.aws.neon.tech/content_os?sslmode=require
WINDMILL_DATABASE_URL=postgresql://windmill_runtime:PASSWORD@HOST.REGION.aws.neon.tech/windmill?sslmode=require

# --- S3-compatible object storage (media) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers (OpenAI-compatible) ---
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# --- MoneyPrinterTurbo ---
MPT_BASE_URL=http://virexa-video.internal:8080
MPT_API_SECRET=

# --- Control Center → API ---
VITE_API_BASE_URL=http://localhost:8000

# --- Global safety state (api) ---
# DRY_RUN=true blocks all public side effects (publish/reply/DM) while keeping research+generation
DRY_RUN=true
